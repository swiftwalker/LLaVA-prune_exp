# Do not commit fetched official repositories.
*/third_party/*
!*/third_party/.gitkeep

# Do not commit method outputs, logs, or caches.
outputs/*
!outputs/.gitkeep
*/outputs/*
!*/outputs/.gitkeep
*/cache/*
__pycache__/
*.pyc
*.tmp
*.log

